generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  AWAITING_RECEIPT
  RECEIPT_SUBMITTED
  APPROVED
  REJECTED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELED
}

enum CustomCakeStatus {
  PENDING_PRICING
  PRICE_OFFERED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum DeliveryType {
  DELIVERY
  PICKUP
}

enum PaymentMode {
  CLICK
  PAYME
  CARD_TRANSFER
  CASH
}

enum PaymentStatus {
  UNPAID
  PENDING
  PENDING_VERIFICATION
  PAID
  FAILED
  REJECTED
}

model User {
  id                 String              @id @default(cuid())
  telegramId         BigInt              @unique
  firstName          String?
  lastName           String?
  username           String?
  phone              String?
  preferredLanguage  String              @default("uz") // "uz", "uz-Cyrl", "ru"
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  orders             Order[]
  customCakeRequests CustomCakeRequest[]

  @@map("users")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  nameUz      String?
  nameUzCyrl  String?
  nameRu      String?
  slug        String    @unique
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("categories")
}

model Product {
  id                String      @id @default(cuid())
  name              String
  nameUz            String?
  nameUzCyrl        String?
  nameRu            String?
  description       String?
  descriptionUz     String?
  descriptionUzCyrl String?
  descriptionRu     String?
  price             Decimal     @db.Decimal(12, 2)
  imageUrl          String?
  isAvailable       Boolean     @default(true)
  categoryId        String
  category          Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]

  @@map("products")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       Int           @default(autoincrement())
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status            OrderStatus   @default(AWAITING_RECEIPT)
  deliveryType      DeliveryType  @default(DELIVERY)
  deliveryRegion    String        @default("Sirdaryo tumani")
  mahalla           String?
  street            String?
  houseNumber       String?
  phone             String?
  addressDetails    String?
  deliveryAddress   String?
  deliveryDate      String?
  latitude          Float?
  longitude         Float?
  paymentMethod     String        @default("CLICK")
  paymentMode       PaymentMode   @default(CARD_TRANSFER)
  paymentReceiptUrl String?
  paymentStatus     PaymentStatus @default(UNPAID)
  totalAmount       Decimal       @db.Decimal(12, 2)
  notes             String?
  adminNotes        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  price       Decimal  @db.Decimal(12, 2)
  quantity    Int
  createdAt   DateTime @default(now())

  @@map("order_items")
}

model CustomCakeRequest {
  id                String           @id @default(cuid())
  requestNumber     Int              @default(autoincrement())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceImageUrl String?
  description       String
  deliveryType      DeliveryType     @default(DELIVERY)
  deliveryRegion    String           @default("Sirdaryo tumani")
  addressDetails    String?
  deliveryAddress   String?
  deliveryDate      String?
  latitude          Float?
  longitude         Float?
  estimatedPrice    Decimal?         @db.Decimal(12, 2)
  status            CustomCakeStatus @default(PENDING_PRICING)
  adminNotes        String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("custom_cake_requests")
}

model SystemSetting {
  id                    String   @id @default(uuid())
  isStoreOpen           Boolean  @default(true)
  deliveryFee           Float    @default(10000.0)
  minOrderAmount        Float    @default(0.0)
  workingHoursStart     String   @default("09:00")
  workingHoursEnd       String   @default("21:00")
  workingDays           String   @default("Dushanba - Yakshanba")
  deliveryAddressText   String   @default("Sirdaryo tumani bo'ylab yetkazib berish")
  adminPhonePrimary     String   @default("+998994957806")
  adminPhoneSecondary   String   @default("+998910231524")
  instagramUrl          String   @default("https://www.instagram.com/dinora_shirinliklari/")
  instagramUsername     String   @default("@dinora_shirinliklari")
  autoAcceptOrders      Boolean  @default(false)
  maintenanceMode       Boolean  @default(false)
  updatedAt             DateTime @updatedAt

  @@map("system_settings")
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      String   @unique
  reason    String?
  createdBy String?
  startTime String?
  endTime   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("blocked_dates")
}
